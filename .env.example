# Copy this file to .env and change the values. Do not commit .env.
# This repository is public. These are placeholders, not real passwords.

# Created on first startup only. Later changes do not reset an existing owner.
OWNER_USERNAME=michael
OWNER_PASSWORD=choose-a-long-password

# Optional. Shown in the header. Defaults to Michael.
OWNER_DISPLAY_NAME=Michael

# Optional SQLite file. Defaults to data/sk-autobody.db
# SQLITE_PATH=data/sk-autobody.db

# Optional. Set this on Vercel (or any host) to use Postgres instead of SQLite.
# Neon’s free pooled connection string works here.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
